  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "check": "concurrently -n lint,fmt,tsc -c magenta,cyan,yellow \"eslint .\" \"prettier --write .\" \"vue-tsc --noEmit\"",
    "build": "vite build && pnpm build:hex",
    "build:hex": "pnpm --filter @amulet-laboratories/hex build",
    "manifest:gen": "vitest run -u src/manifest.test.ts",
    "prepublishOnly": "pnpm build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "story:dev": "histoire dev",
    "story:build": "histoire build && node scripts/histoire-post-build.mjs",
    "story:preview": "histoire preview"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*.{ts,vue,css,json,md}": "prettier --write"
